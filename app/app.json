{
  "expo": {
    "name": "Claude Usage",
    "slug": "claude-usage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aleksanderbuszek.claudeusage",
      "appleTeamId": "NUTTBQVL3H",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.aleksanderbuszek.claudeusage"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-camera",
        {
          "cameraPermission": "Claude Usage uses the camera to scan the pairing QR code.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
