import Foundation

// Copy this file to Config.swift (same folder) and fill in your own values.
// Config.swift is gitignored. This template deliberately does not end in .swift,
// otherwise it would be compiled into the widget and clash with Config.swift.
enum Config {
    // Supabase project URL, e.g. "https://xxxx.supabase.co"
    static let supabaseURL = "https://YOUR-PROJECT.supabase.co"
    // Supabase publishable key (sb_publishable_...). It can only call the read-only RPC latest_usage().
    static let publishableKey = "sb_publishable_YOUR_KEY"

    // How soon the widget asks iOS to refresh it. This is only a request; iOS may refresh less often.
    static let refreshInterval: TimeInterval = 5 * 60
    // A snapshot older than this is shown as stale.
    static let staleAfter: TimeInterval = 15 * 60
    // Length of the usage window reported by ccusage.
    static let windowLength: TimeInterval = 5 * 60 * 60
}
